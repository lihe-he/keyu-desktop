{
  "name": "campus-course-desktop",
  "version": "0.1.5",
  "description": "本地优先的大学生网课学习助手",
  "main": "out/main/index.js",
  "author": "Campus Course Desktop",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test --project=desktop",
    "test:soak": "pnpm build && playwright test tests/e2e/soak.spec.ts --project=soak",
    "check": "pnpm typecheck && pnpm test && pnpm test:e2e",
    "pack": "pnpm build && electron-builder --win --x64 --dir",
    "dist": "pnpm build && electron-builder --win nsis --x64",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "lucide-vue-next": "1.0.0",
    "pinia": "4.1.0",
    "vue": "3.5.44",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.10.0",
    "@vitejs/plugin-vue": "6.0.10",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.14"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lihe-he/keyu-desktop.git"
  }
}
